#!/bin/sh
# Boot step of the Flowly cloud machine (flowly-cloud-setup.service), before
# root's user manager starts the gateway. Idempotent; runs on every boot.
set -u
export HOME=/root

# Screen accounts live in /etc/passwd (reset with the root filesystem); their
# receipts live on the volume. A failure here only keeps the affected screen
# failing closed; the agent itself still starts.
if ! flowly screen restore-accounts; then
  echo "flowly-cloud-setup: some screen accounts were not restored (see above)" >&2
fi

# Nothing of the previous boot is alive now. A screen that was running when the
# machine stopped or was redeployed is still recorded as running, and Core
# refuses to start over it (RUNTIME_RECOVERY_REQUIRED); close that record.
case "$(flowly screen status 2>/dev/null)" in
  *'"error": "RUNTIME_RECOVERY_REQUIRED"'*|*'"error": "RUNTIME_FAILED"'*)
    if flowly screen stop >/dev/null; then
      echo "flowly-cloud-setup: closed the screen left running by the previous boot"
    else
      echo "flowly-cloud-setup: could not close the previous boot's screen" >&2
    fi ;;
esac

# Core's config from the machine's secrets. Without it the gateway cannot start.
set -a
. /etc/flowly/cloud/setup.env
set +a
exec /opt/flowly/venv/bin/python /opt/flowly/cloud/flowly_cloud_config.py
